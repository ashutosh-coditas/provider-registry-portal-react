# Base URL for API calls. With the mock API on, requests never leave the browser.
VITE_API_BASE_URL=/api
# true → axios uses the localStorage-backed mock adapter (src/services/mock)
VITE_USE_MOCK_API=true
# Artificial latency for mock responses, in milliseconds
VITE_MOCK_DELAY_MS=300
# Shows demo-only helpers (seed accounts on login, user switcher)
VITE_SHOW_DEMO_TOOLS=true
